rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLanguage(lang) {
      return lang is string && lang in ['english', 'tamil', 'bilingual'];
    }

    function isValidInteractionMode(mode) {
      return mode is string && mode in ['typing', 'voice', 'both', 'not_sure'];
    }

    function isValidStringList(listVal, maxLen) {
      return listVal is list
        && listVal.size() <= maxLen
        && (listVal.size() == 0 || listVal[0] is string);
    }

    // ===============================================================
    // Validation Blueprints (called on both create and update)
    // ===============================================================

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'preferredLanguage', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'preferredLanguage', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && isValidLanguage(data.preferredLanguage)
        && data.createdAt is string
        && data.createdAt.size() <= 64
        && data.updatedAt is string
        && data.updatedAt.size() <= 64;
    }

    function isValidUserPreferences(data, userId) {
      return data.keys().hasAll([
          'uid',
          'preferredLanguage',
          'preferredInteractionMode',
          'selectedGoals',
          'preferredSupportMethods',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'preferredLanguage',
          'preferredInteractionMode',
          'selectedGoals',
          'preferredSupportMethods',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidLanguage(data.preferredLanguage)
        && isValidInteractionMode(data.preferredInteractionMode)
        && isValidStringList(data.selectedGoals, 12)
        && isValidStringList(data.preferredSupportMethods, 10)
        && data.updatedAt is string
        && data.updatedAt.size() <= 64;
    }

    function isValidUserOnboarding(data, userId) {
      return data.keys().hasAll(['uid', 'completed', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'completed', 'completedAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.completed is bool
        && (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 64))
        && data.updatedAt is string
        && data.updatedAt.size() <= 64;
    }

    // ===============================================================
    // User-Owned Collections (Strict PII Isolation, Zero Public Access)
    // ===============================================================

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(request.resource.data, userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'email', 'preferredLanguage', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /preferences/{documentId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(documentId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(documentId)
          && isValidUserPreferences(request.resource.data, userId);
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(documentId)
          && isValidUserPreferences(request.resource.data, userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['preferredLanguage', 'preferredInteractionMode', 'selectedGoals', 'preferredSupportMethods', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(documentId);
      }

      match /onboarding/{documentId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(documentId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(documentId)
          && isValidUserOnboarding(request.resource.data, userId);
        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(documentId)
          && isValidUserOnboarding(request.resource.data, userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['completed', 'completedAt', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(documentId);
      }
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
